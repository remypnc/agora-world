# ─── Cerveau des agents (choisis UN fournisseur gratuit) ─────────────
# mock       = pas d'IA, comportements simulés (pour tester la ville)
# openrouter = modèles ":free" d'OpenRouter (clé gratuite)
# groq       = API Groq (palier gratuit, très rapide)
# gemini     = Google AI Studio (palier gratuit), via l'endpoint compatible OpenAI
# ollama     = modèle local sur ton ordi (100 % gratuit, illimité)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
# Exemples de modèles :
#   openrouter : meta-llama/llama-3.3-70b-instruct:free
#   groq       : llama-3.3-70b-versatile
#   gemini     : gemini-2.0-flash
#   ollama     : qwen2.5:7b

# ─── Rythme du monde ────────────────────────────────────────────────
PORT=4173
TICK_SECONDS=20          # un agent agit toutes les N secondes (tour par tour)
MAX_CALLS_PER_DAY=900    # garde-fou pour rester sous les quotas gratuits

# ─── Population ─────────────────────────────────────────────────────
# genesis = le monde démarre avec UN seul fondateur, qui recrute et fait naître les autres
# village = démarre avec les 20 entrepreneurs de presets/village
WORLD_SEED=genesis
AUTO_SPAWN=on            # on = les agents naissent tout seuls ; off = chaque naissance passe par toi
MAX_AGENTS=40            # population maximale
MAX_SPAWNS_PER_DAY=6     # naissances max par jour (protège les quotas gratuits)

# ─── Argent réel : webhooks des plateformes de paiement ─────────────
# Les agents ne peuvent PAS déclarer eux-mêmes un revenu : seul un webhook
# signé (ou ta validation manuelle) ajoute de l'argent au classement.
LEMONSQUEEZY_WEBHOOK_SECRET=
GUMROAD_WEBHOOK_TOKEN=
STRIPE_WEBHOOK_SECRET=

# ─── Exécution réelle (optionnel) ───────────────────────────────────
# Si "claude" (Claude Code) est installé, les tâches validées peuvent être
# exécutées dans le dossier de l'agent avec ses MCP.
RUNNER=off               # off | claude
ADMIN_TOKEN=change-moi   # protège les routes d'approbation du dashboard
