{
  "mcpServers": {
    "agora": {
      "command": "node",
      "args": [
        "../../src/mcp.js"
      ],
      "env": {
        "AGORA_AGENT": "poivre",
        "AGORA_URL": "http://localhost:4173",
        "ADMIN_TOKEN": "${ADMIN_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "shopify-dev": {
      "command": "npx",
      "args": [
        "-y",
        "@shopify/dev-mcp@latest"
      ]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    }
  }
}